# --- Banco de dados ---
DATABASE_URL="postgresql://plataforma:plataforma@localhost:5432/plataformaemais?schema=public"

# --- Auth.js (NextAuth) ---
AUTH_SECRET="troque-este-valor-em-producao"
NEXTAUTH_URL="http://localhost:3000"

# SSO opcional (deixe em branco para operar apenas com login por e-mail/senha)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
AUTH_OKTA_ID=""
AUTH_OKTA_SECRET=""
AUTH_OKTA_ISSUER=""

# --- IA (opcional) ---
# Se não configurado, o assistente e os recursos de IA operam em modo offline
# (busca extrativa + heurísticas locais) em vez de chamar um provedor externo.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Integrações ---
HRIS_WEBHOOK_API_KEY="troque-esta-chave"
SLACK_WEBHOOK_URL=""
TEAMS_WEBHOOK_URL=""
POWERBI_API_KEY="troque-esta-chave-tambem"

# --- App ---
APP_BASE_URL="http://localhost:3000"
